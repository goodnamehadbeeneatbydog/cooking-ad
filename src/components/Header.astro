---
import { t, type Lang, LANGUAGES } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;

function switchLangUrl(targetLang: Lang): string {
  const segments = pathname.split('/').filter(Boolean);
  if (segments.length === 0) return `/${targetLang}`;
  if (LANGUAGES.includes(segments[0] as Lang)) {
    segments[0] = targetLang;
  } else {
    segments.unshift(targetLang);
  }
  return '/' + segments.join('/');
}

const navItems = [
  { href: `/${lang}`, label: t(lang, 'nav.home') },
  { href: `/${lang}/blog`, label: t(lang, 'nav.blog') },
  { href: `/${lang}/about`, label: t(lang, 'nav.about') },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href={`/${lang}`} class="text-xl font-bold text-primary hover:text-primary-hover transition-colors font-display">
        {lang === 'zh' ? '中餐指南' : 'Chinese Cooking Guide'}
      </a>

      <nav class="hidden md:flex space-x-8">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors ${
              pathname === item.href || pathname.startsWith(item.href + '/')
                ? 'text-primary'
                : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center space-x-4">
        <div class="flex space-x-2">
          {LANGUAGES.map(l => (
            <a
              href={switchLangUrl(l)}
              class={`px-2 py-1 text-xs rounded transition-colors ${
                l === lang
                  ? 'bg-primary text-white'
                  : 'bg-gray-100 text-text-secondary hover:bg-gray-200'
              }`}
            >
              {l === 'zh' ? '中' : 'EN'}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>
